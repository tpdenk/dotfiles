{{with .Message -}}
    {{. -}}
{{else with .Stat -}}
    {{humanize .Size | printf "\033[38;2;192;202;245m%s\033[0m" -}}
    {{if eq (substr .Permissions 2 1) "-"}}{{printf "  \033[38;2;255;158;100m󰍁\033[0m"}}{{end -}}
    {{.ModTime | printf "  \033[38;2;86;95;137m%s\033[0m" -}}
    {{with .Target}} {{printf "\033[38;2;86;95;137m󱦰\033[0m \033[38;2;125;207;255m%s\033[0m" .}}{{end -}}
{{end -}}
{{.SPACER -}}
{{if eq .Mode "VISUAL"}}{{printf "%s VISUAL \033[0m  " $.Options.visualfmt}}{{end -}}
{{with .Keys}}{{printf "\033[38;2;255;158;100m%s\033[0m  " .}}{{end -}}
{{with .Progress}}{{printf "\033[38;2;125;207;255m%s\033[0m  " (join . " ")}}{{end -}}
{{with .Copy}}{{len . | printf "%s 󰆏 %d \033[0m  " $.Options.copyfmt}}{{end -}}
{{with .Cut}}{{len . | printf "%s 󰆐 %d \033[0m  " $.Options.cutfmt}}{{end -}}
{{with .Select}}{{len . | printf "%s 󰄲 %d \033[0m  " $.Options.selectfmt}}{{end -}}
{{with .Filter}}{{join . " " | printf "\033[38;2;125;207;255m󰍉 %s\033[0m  "}}{{end -}}
{{if gt .Hidden 0}}{{.Hidden | printf "\033[38;2;86;95;137m󰛑 %d\033[0m  "}}{{end -}}
{{printf "\033[38;2;122;162;247m%d\033[0m\033[38;2;86;95;137m/%d\033[0m" .Index .Total -}}
{{df | printf "  \033[38;2;86;95;137m%s\033[0m"}}
