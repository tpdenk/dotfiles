# See https://git-scm.com/docs/git-config

[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
[commit]
	verbose = false
    gpgsign = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[filter "lfs"]
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
	clean = git-lfs clean -- %f
[tag]
	sort = -version:refname
[rerere]
	enabled = true
	autoupdate = true
[user]
	name = Tim Denk
	email = tim.denk@zymtrace.com
    signingkey = ~/.ssh/id_ed25519.pub
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = /home/tpdenk/.ssh/allowed_signers
[sequence]
	editor = interactive-rebase-tool
[remote "origin"]
	; fetch = +refs/heads/*:refs/remotes/origin/*
[rebase]
	autosquash = true
